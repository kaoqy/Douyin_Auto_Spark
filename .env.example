# 抖音自动续火花管理面板 - 环境变量示例
# 复制为 .env 并修改

# 管理员配置（首次部署）
DAS_ADMIN_USER=admin
DAS_ADMIN_PASSWORD=admin123

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据目录
DAS_DATA_DIR=./data

# Playwright 配置
PLAYWRIGHT_HEADLESS=1
# PLAYWRIGHT_BROWSER_PATH=/usr/bin/chromium

# Docker 镜像
DAS_IMAGE=douyin-auto-spark:latest
DAS_PORT=8001
